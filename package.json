{
  "name": "camping-search-api",
  "version": "1.0.0",
  "description": "API REST de recherche de campings Yelloh! Village disponibles, pour applications tierces (spécification : specs/specifications.md)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/dev-server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "keys:generate": "tsx scripts/generate-api-key.ts",
    "openapi": "tsx scripts/write-openapi.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
