# Configuration locale (npm run dev lit .env). Valeurs FACTICES : ne jamais committer de vraies clés.
# Sur Netlify : Project configuration > Environment variables, scope « Functions » ; les clés en « secret ».

# Obligatoires
REST_API_BASE_URL=https://camping-search-api.netlify.app/v1
REST_API_KEY_CLAUDE=ysk_live_REMPLACER_PAR_LA_CLE_DU_CLIENT_mcp-claude____
REST_API_KEY_CHATGPT=ysk_live_REMPLACER_PAR_LA_CLE_DU_CLIENT_mcp-chatgpt___

# Facultatives (valeurs par défaut indiquées)
# REST_API_KEY_DEFAULT=            # si absente, la route /mcp générique répond 404
# REST_API_TIMEOUT_MS=12000
# CATALOG_TTL_SECONDS=86400
# TOKEN_RENEW_BEFORE_SECONDS=300
# MCP_MAX_RESULTS_LIMIT=5
# MCP_RATE_LIMIT_PER_MINUTE=30
# MCP_ALLOWED_ORIGINS=             # origines navigateur autorisées (ex. MCP Inspector local)
# LOG_LEVEL=info
